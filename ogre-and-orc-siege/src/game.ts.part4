
    const offline = this.time < this.towerShutdownUntil;
    this.applyAuras();
    for (const tower of this.towers) {
      this.setTowerPower(tower, !offline);
      if (tower.cooldown > 0) tower.cooldown -= dt;
      if (tower.recoil > 0) tower.recoil = Math.max(0, tower.recoil - dt * 4.5);
      // a support dish carries no gun; it feeds the towers around it instead
      if (tower.def.aura) continue;

      const armed = this.phase === 'fight' && !offline;
      const target = armed ? this.targetFor(tower) : null;

      if (tower.head && target) {
        const angle = Math.atan2(target.pos.x - tower.center.x, target.pos.z - tower.center.z);
        tower.head.rotation.y = smoothAngle(tower.head.rotation.y, angle, dt * 5);
      }
      if (tower.head) tower.head.position.z = tower.headPos.z - tower.recoil * 0.12;

      // gatling barrels wind up while firing and spin down when idle
      if (tower.def.id === 'gatling') {
        tower.spin = target ? Math.min(1, tower.spin + dt * 1.2) : Math.max(0, tower.spin - dt * 0.8);
      }

      if (!armed || tower.cooldown > 0 || !target) continue;
      const spin = tower.def.id === 'gatling' ? 1 + tower.spin * 0.6 : 1;
      tower.cooldown = 1 / (rateOf(tower) * spin);
      tower.recoil = 1;
      this.fireTower(tower, target);
    }
  }

  /** Radar dishes feed every tower in reach: a wider ring and a faster reload. */
  private applyAuras(): void {
    for (const tower of this.towers) {
      tower.auraStacks = 0;
      tower.buffRange = 1;
      tower.buffRate = 1;
    }
    for (const dish of this.towers) {
      const aura = dish.def.aura;
      if (!aura) continue;
      const r2 = aura.range * aura.range;
      for (const tower of this.towers) {
        if (tower === dish) continue;
        if (tower.def.aura) continue;
        const dx = tower.center.x - dish.center.x;
        const dz = tower.center.z - dish.center.z;
        if (dx * dx + dz * dz > r2) continue;
        tower.auraStacks += 1;
        // a second dish adds its bonus, a third adds nothing more
        const stacks = Math.min(2, tower.auraStacks);
        tower.buffRange = 1 + aura.rangeBoost * stacks;
        tower.buffRate = 1 + aura.rateBoost * stacks;
      }
    }
  }

  private findTarget(tower: Tower): Enemy | null {
    const range = rangeOf(tower);
    const r2 = range * range;
    let best: Enemy | null = null;
    for (const enemy of this.enemies) {
      if (enemy.dead) continue;
      const dx = enemy.pos.x - tower.center.x;
      const dz = enemy.pos.z - tower.center.z;
      if (dx * dx + dz * dz > r2) continue;
      if (!best || enemy.d > best.d) best = enemy;
    }
    return best;
  }

  /** Each tower type picks its own prey: deepest in the lane, toughest, or closest. */
  private targetFor(tower: Tower): Enemy | null {
    const mode = tower.def.targeting ?? 'first';
    if (mode === 'nearest') return this.findClosestTarget(tower);
    if (mode === 'strongest') return this.findStrongestTarget(tower);
    return this.findTarget(tower);
  }

  private findStrongestTarget(tower: Tower): Enemy | null {
    const range = rangeOf(tower);
    const r2 = range * range;
    let best: Enemy | null = null;
    for (const enemy of this.enemies) {
      if (enemy.dead) continue;
      const dx = enemy.pos.x - tower.center.x;
      const dz = enemy.pos.z - tower.center.z;
      if (dx * dx + dz * dz > r2) continue;
      if (!best || enemy.hp > best.hp) best = enemy;
    }
    return best;
  }

  private findClosestTarget(tower: Tower): Enemy | null {
    const range = rangeOf(tower);
    const r2 = range * range;
    let best: Enemy | null = null;
    let bestD = Infinity;
    for (const enemy of this.enemies) {
      if (enemy.dead) continue;
      const dx = enemy.pos.x - tower.center.x;
      const dz = enemy.pos.z - tower.center.z;
      const d2 = dx * dx + dz * dz;
      if (d2 > r2 || d2 >= bestD) continue;
      bestD = d2;
      best = enemy;
    }
    return best;
  }

  private enemiesInRange(center: THREE.Vector3, range: number): Enemy[] {
    const r2 = range * range;
    const out: Enemy[] = [];
    for (const enemy of this.enemies) {
      if (enemy.dead) continue;
      const dx = enemy.pos.x - center.x;
      const dz = enemy.pos.z - center.z;
      if (dx * dx + dz * dz <= r2) out.push(enemy);
    }
    return out;
  }

  private payloadFor(tower: Tower): Payload {
    const def = tower.def;
    return {
      damage: dmgOf(tower),
      splash: def.splash ?? 0,
      slow: def.slow,
      slowTime: def.slowTime,
      freeze: def.freeze,
      burnDps: def.burnDps,
      burnTime: def.burnTime,
      physical: PHYSICAL_KINDS.has(def.kind),
      armorPierce: def.armorPierce ?? 0,
      pull: def.pull,
      pierce: def.pierce,
      color: KIND_COLOR[def.kind] ?? 0xffd08a,
      source: tower,
    };
  }

  private fireTower(tower: Tower, target: Enemy): void {
    const def = tower.def;
    const payload = this.payloadFor(tower);

    if (def.kind === 'arrow' && (def.targets ?? 1) > 1) {
      const targets = this.enemiesInRange(tower.center, rangeOf(tower)).sort((a, b) => b.d - a.d);
      const shots = def.targets ?? 3;
      for (let i = 0; i < shots; i++) {
        const enemy = targets[i % Math.max(1, targets.length)];
        if (enemy) this.launch(tower, enemy, payload);
      }
      return;
    }

    switch (def.kind) {
      case 'flame': {
        // burning oil: everything inside the wedge catches fire
        const dir = new THREE.Vector3().subVectors(target.pos, tower.center);
        dir.y = 0;
        dir.normalize();
        const half = def.cone ?? 0.55;
        const cos = Math.cos(half);
        for (const enemy of this.enemiesInRange(tower.center, rangeOf(tower))) {
          const to = new THREE.Vector3().subVectors(enemy.pos, tower.center);
          to.y = 0;
          if (to.length() < 0.001) continue;
          if (to.normalize().dot(dir) < cos) continue;
          this.applyPayload(enemy, payload.damage, payload);
        }
        this.addCone(tower.center, dir, rangeOf(tower), 0xff8a3c);
        break;
      }
      case 'sniper': {
        // hitscan: a tracer and a hole, no travel time
        const from = new THREE.Vector3(tower.center.x, def.muzzle, tower.center.z);
        this.addBeam(from, target.pos.clone().setY(0.7), 0x9ad8c8, 0.3);
        this.applyPayload(target, payload.damage, payload);
        this.addBurst(target.pos, 0x9ad8c8, 0.7);
        break;
      }
      case 'laser': {
        const from = new THREE.Vector3(tower.center.x, def.muzzle, tower.center.z);
        this.addBeam(from, target.pos.clone().setY(0.7), 0x8fd8ff, 0.18);
        this.damageEnemy(target, payload.damage, false, tower, 1);
        this.addBurst(target.pos, 0x8fd8ff, 0.4);
        break;
      }
      case 'emp': {
        // no projectile: the charge drops where the target stands and stuns the cluster
        const radius = def.splash ?? 3;
        for (const enemy of this.enemiesInRange(target.pos, radius)) {
          this.applyPayload(enemy, payload.damage, payload);
        }
        this.addRing(target.pos, radius, 0x7fd8ff);
        this.addBurst(target.pos, 0x7fd8ff, 1.1);
        break;
      }
      case 'quantum': {
        if (this.rng() < (def.surge ?? 0)) {
          payload.damage *= 2;
          payload.color = 0xe8d6ff;
        }
        this.launch(tower, target, payload);
        break;
      }
      case 'drone': {
        // every drone picks its own target and flies its own line
        const shots = def.targets ?? 3;
        const targets = this.enemiesInRange(tower.center, rangeOf(tower)).sort((a, b) => b.d - a.d);
        for (let i = 0; i < shots && targets.length > 0; i++) {
          const enemy = targets[i % targets.length];
          this.launchAt(tower, enemy.pos.clone(), payload, enemy);
        }
        break;
      }
      case 'tesla': {
        let from = new THREE.Vector3(tower.center.x, def.muzzle, tower.center.z);
        let current: Enemy | null = target;
        const hit = new Set<Enemy>();
        const chain = 1 + (def.chain ?? 0);
        for (let i = 0; i < chain && current; i++) {
          this.addLightning(from, current.pos.clone().setY(0.6), 0x9fe8ff);
          // an infiltrator takes double damage from a tesla bolt that hits it directly
          const direct = i === 0 && current.def.id === 'infiltrator' ? 2 : 1;
          if (direct === 2) this.teslaBonusHits += 1;
          this.damageEnemy(current, payload.damage * Math.pow(0.78, i) * direct, false, tower);
          hit.add(current);
          from = current.pos.clone().setY(0.6);
          current = this.nearestEnemy(from, 4.2, hit);
        }
        break;
      }
      case 'storm': {
        const count = def.targets ?? 4;
        const targets = this.enemiesInRange(tower.center, rangeOf(tower)).sort((a, b) => b.d - a.d);
        for (const enemy of targets.slice(0, count)) {
          const from = new THREE.Vector3(
            enemy.pos.x + (this.rng() - 0.5) * 5,
            5.5,
            enemy.pos.z + (this.rng() - 0.5) * 5,
          );
          this.addLightning(from, enemy.pos.clone().setY(0.5), 0xd8ecff);
          this.damageEnemy(enemy, payload.damage, false, tower);
        }
        this.addBurst(target.pos, 0xcfe6ff, 1.6);
        break;
      }
      default:
        this.launch(tower, target, payload);
        break;
    }
  }

  private nearestEnemy(from: THREE.Vector3, maxDist: number, exclude: Set<Enemy>): Enemy | null {
    let best: Enemy | null = null;
    let bestDist = maxDist * maxDist;
    for (const enemy of this.enemies) {
      if (enemy.dead || exclude.has(enemy)) continue;
      const dx = enemy.pos.x - from.x;
      const dz = enemy.pos.z - from.z;
      const d2 = dx * dx + dz * dz;
      if (d2 <= bestDist) {
        bestDist = d2;
        best = enemy;
      }
    }
    return best;
  }

  private launch(tower: Tower, target: Enemy, payload: Payload): void {
    this.launchAt(tower, new THREE.Vector3(target.pos.x, target.pos.y, target.pos.z), payload, target);
  }

  /** Fires a shot at a fixed point, used by the artillery blanket. */
  private launchAt(tower: Tower, at: THREE.Vector3, payload: Payload, target: Enemy | null): void {
    const def = tower.def;
    const mesh = makeProjectileMesh(def.kind);
    const from = new THREE.Vector3(tower.center.x, def.muzzle, tower.center.z);
    const to = at.clone();
    const speed = def.projSpeed ?? 32;
    const dist = from.distanceTo(to);
    const ballistic =
      def.kind === 'cannon' ||
      def.kind === 'shell' ||
      def.kind === 'plasma' ||
      def.kind === 'void' ||
      def.kind === 'artillery';
    mesh.position.copy(from);
    this.fxLayer.add(mesh);
    this.projectiles.push({
      mesh,
      from,
      to,
      t: 0,
      dur: Math.max(0.09, dist / speed),
      arc: ballistic ? Math.min(3.4, dist * 0.11) : 0,
      target,
      payload,
      kind: def.kind,
      done: false,
    });
  }

  private updateProjectiles(dt: number): void {
    for (const p of this.projectiles) {
      p.t += dt / p.dur;
      if (p.target && !p.target.dead) {
        p.to.lerp(new THREE.Vector3(p.target.pos.x, p.target.pos.y, p.target.pos.z), Math.min(1, dt * 9));
      }
      const k = Math.min(1, p.t);
      const pos = new THREE.Vector3().lerpVectors(p.from, p.to, k);
      pos.y += Math.sin(Math.PI * k) * p.arc;
      if (p.kind === 'arrow') {
        const dir = new THREE.Vector3().subVectors(p.to, p.from);
        p.mesh.rotation.y = Math.atan2(dir.x, dir.z);
      }
      p.mesh.position.copy(pos);
      if (p.t >= 1) {
        this.impact(p.from, p.to, p.payload);
        this.fxLayer.remove(p.mesh);
        p.done = true;
      }
    }
    this.projectiles = this.projectiles.filter((p) => !p.done);
  }

  /** Piercing shots drill a corridor: they hit the file, never the neighbourhood. */
  private pierceLine(from: THREE.Vector3, to: THREE.Vector3, payload: Payload): void {
    const dx = to.x - from.x;
    const dz = to.z - from.z;
    const len2 = dx * dx + dz * dz || 1;
    const limit = payload.pierce ?? 1;
    const hits: { enemy: Enemy; t: number }[] = [];
    for (const enemy of this.enemies) {
      if (enemy.dead) continue;
      const t = Math.max(0, Math.min(1, ((enemy.pos.x - from.x) * dx + (enemy.pos.z - from.z) * dz) / len2));
      const cx = from.x + dx * t;
      const cz = from.z + dz * t;
      const off = Math.hypot(enemy.pos.x - cx, enemy.pos.z - cz);
      if (off > 0.8 + enemy.def.radius) continue;
      hits.push({ enemy, t });
    }
    hits.sort((a, b) => a.t - b.t);
    for (const hit of hits.slice(0, limit)) {
      this.applyPayload(hit.enemy, payload.damage, payload);
      this.addBurst(hit.enemy.pos, payload.color, 0.5);
    }
    this.addBeam(from.clone().setY(0.6), to.clone().setY(0.6), payload.color, 0.24);
    this.addBurst(to, payload.color, 0.7);
  }

  private impact(from: THREE.Vector3, pos: THREE.Vector3, payload: Payload): void {
    if (payload.pierce) {
      this.pierceLine(from, pos, payload);
      return;
    }
    const radius = Math.max(0.55, payload.splash);
    for (const enemy of this.enemies) {
      if (enemy.dead) continue;
      const dist = Math.hypot(enemy.pos.x - pos.x, enemy.pos.z - pos.z);
      if (dist <= radius + enemy.def.radius) {
        const falloff = payload.splash > 0 ? 1 - 0.45 * (dist / radius) : 1;
        this.applyPayload(enemy, payload.damage * falloff, payload);
      }
    }
    if (payload.pool) this.addHazard(pos, payload.pool, payload.color, payload.source);
    this.addBurst(pos, payload.color, payload.splash > 0 ? 1.6 : 0.7);
  }

  private applyPayload(enemy: Enemy, amount: number, payload: Payload): void {
    if (enemy.dead) return;
    // trap-wave monsters shrug off crowd control; bosses only shake part of it off
    const ccProof = enemy.ccImmune;
    const ccMul = 1 - clamp(enemy.ccResist, 0, 0.95);
    if (payload.slow !== undefined) {
      if (ccProof) {
        if (import.meta.env.DEV) this.ccTally.blocked += 1;
      } else {
        // a boss keeps most of its pace: resist shallow slow and shorten it
        const slow = 1 - (1 - payload.slow) * ccMul;
        if (slow < enemy.slowFactor || enemy.slowUntil < this.time) enemy.slowFactor = slow;
        enemy.slowUntil = Math.max(enemy.slowUntil, this.time + (payload.slowTime ?? 1) * ccMul);
        if (import.meta.env.DEV) this.ccTally.slowed += 1;
      }
    }
    if (payload.freeze) {
      if (ccProof) {
        if (import.meta.env.DEV) this.ccTally.blocked += 1;
      } else if (enemy.ccResist > 0) {
        // a boss is never frozen solid — the freeze lands as a heavy, brief slow
        const slow = 1 - 0.65 * ccMul;
        if (slow < enemy.slowFactor || enemy.slowUntil < this.time) enemy.slowFactor = slow;
        enemy.slowUntil = Math.max(enemy.slowUntil, this.time + payload.freeze * ccMul);
        if (import.meta.env.DEV) this.ccTally.slowed += 1;
      } else {
        enemy.freezeUntil = Math.max(enemy.freezeUntil, this.time + payload.freeze * ccMul);
        if (import.meta.env.DEV) this.ccTally.froze += 1;
      }
    }
    if (payload.burnDps) {
      enemy.burnDps = Math.max(enemy.burnDps, payload.burnDps);
      enemy.burnUntil = Math.max(enemy.burnUntil, this.time + (payload.burnTime ?? 0));
    }
    if (payload.pull) {
      // gravity drags the walker back up its lane, never past the portal
      enemy.d = Math.max(0, enemy.d - payload.pull);
      if (import.meta.env.DEV) this.ccTally.slowed += 1;
    }
    this.damageEnemy(enemy, amount, payload.physical, payload.source, payload.armorPierce ?? 0);
  }

  private damageEnemy(
    enemy: Enemy,
    amount: number,
    physical: boolean,
    source: Tower | null,
    armorPierce = 0,
  ): void {
    if (enemy.dead || amount <= 0) return;
    const armor = physical ? enemy.def.armor * (1 - clamp(armorPierce, 0, 1)) : 0;
    const dealt = amount * (1 - armor);
    enemy.hp -= dealt;
    if (source) enemy.lastSource = source;
    if (enemy.hp <= 0) this.killEnemy(enemy);
  }

  private killEnemy(enemy: Enemy): void {
    if (enemy.dead) return;
    enemy.dead = true;
    this.removeEnemyVisual(enemy);
    this.gold += enemy.reward;
    this.ui.setGold(this.gold);
    if (enemy.lastSource) enemy.lastSource.kills++;
    this.addBurst(new THREE.Vector3(enemy.pos.x, Math.max(0.4, enemy.pos.y), enemy.pos.z), enemy.def.color, 0.5 + enemy.def.scale * 0.6);
    if (this.boss === enemy) {
      this.boss = null;
      this.ui.setBoss(null);
      this.lastBossKey = '';
      this.ui.toast(`${enemy.def.name} has been slain!`, 'good');
    }
    this.updateRemaining();
  }

  private leakEnemy(enemy: Enemy): void {
    if (enemy.dead) return;
    enemy.dead = true;
    this.removeEnemyVisual(enemy);
    this.lives -= enemy.def.lives;
    if (this.lives < 0) this.lives = 0;
    this.ui.setLives(this.lives);
    this.ui.toast(`${enemy.def.name} breached the gate! −${enemy.def.lives}`, 'bad');
    this.addRing(new THREE.Vector3(tileCenterX(GATE_TILE.x), 0.2, tileCenterZ(GATE_TILE.z)), 4.5, 0xff6a4a);
    if (this.boss === enemy) {
      this.boss = null;
      this.ui.setBoss(null);
      this.lastBossKey = '';
    }
    this.updateRemaining();
    if (this.lives <= 0) this.defeat();
  }

  private removeEnemyVisual(enemy: Enemy): void {
    this.enemyLayer.remove(enemy.group);
    this.uiLayer.remove(enemy.bar);
  }

  // -------------------------------------------------------------------------
  // hazards and effects
  // -------------------------------------------------------------------------

  private addHazard(pos: THREE.Vector3, spec: { dps: number; time: number; radius: number }, color: number, source: Tower | null): void {
    const mat = new THREE.MeshBasicMaterial({
      color,
      transparent: true,
      opacity: 0.5,
      depthWrite: false,
      side: THREE.DoubleSide,
      blending: THREE.AdditiveBlending,
    });
    const mesh = new THREE.Mesh(new THREE.CircleGeometry(1, 26), mat);
    mesh.rotation.x = -Math.PI / 2;
    mesh.position.set(pos.x, 0.075, pos.z);
    mesh.scale.setScalar(spec.radius);
    this.fxLayer.add(mesh);
    this.hazards.push({ mesh, radius: spec.radius, dps: spec.dps, until: this.time + spec.time, source });
  }

  private updateHazards(dt: number): void {
    const expired: Hazard[] = [];
    for (const hazard of this.hazards) {
      if (this.time >= hazard.until) {
        expired.push(hazard);
        continue;
      }
      const pulse = 0.94 + Math.sin(this.time * 5 + hazard.mesh.position.x) * 0.06;
      hazard.mesh.scale.setScalar(hazard.radius * pulse);
      for (const enemy of this.enemies) {
        if (enemy.dead) continue;
        const dist = Math.hypot(enemy.pos.x - hazard.mesh.position.x, enemy.pos.z - hazard.mesh.position.z);
        if (dist <= hazard.radius + enemy.def.radius) {
          this.damageEnemy(enemy, hazard.dps * dt, false, hazard.source);
        }
      }
    }
    if (expired.length) {
      for (const hazard of expired) {
        this.fxLayer.remove(hazard.mesh);
        hazard.mesh.geometry.dispose();
        (hazard.mesh.material as THREE.Material).dispose();
      }
      this.hazards = this.hazards.filter((h) => !expired.includes(h));
    }
  }

  private addEffect(effect: Effect): void {
    this.fxLayer.add(effect.obj);
    this.effects.push(effect);
  }

  private addBurst(pos: THREE.Vector3, color: number, size: number): void {
    const mat = new THREE.MeshBasicMaterial({
      color,
      transparent: true,
      opacity: 0.9,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    const mesh = new THREE.Mesh(this.burstGeo, mat);
    mesh.position.copy(pos);
    mesh.position.y = Math.max(0.3, pos.y);
    mesh.scale.setScalar(size * 0.4);
    this.addEffect({
      obj: mesh,
      ttl: 0.42,
      life: 0.42,
      onUpdate: (k) => {
        mesh.scale.setScalar(size * (0.35 + k * 1.4));
        mat.opacity = 0.9 * (1 - k);
      },
      cleanup: () => mat.dispose(),
    });
  }

  private addRing(pos: THREE.Vector3, radius: number, color: number): void {
    const mat = new THREE.MeshBasicMaterial({
      color,
      transparent: true,
      opacity: 0.85,
      depthWrite: false,
      side: THREE.DoubleSide,
      blending: THREE.AdditiveBlending,
    });
    const mesh = new THREE.Mesh(this.ringGeo, mat);
    mesh.rotation.x = -Math.PI / 2;
    mesh.position.set(pos.x, 0.11, pos.z);
    mesh.scale.setScalar(radius * 0.3);
    this.addEffect({
      obj: mesh,
      ttl: 0.5,
      life: 0.5,
      onUpdate: (k) => {
        mesh.scale.setScalar(radius * (0.3 + k * 1.05));
        mat.opacity = 0.85 * (1 - k);
      },
      cleanup: () => mat.dispose(),
    });
  }

  /** A straight energy beam — used by the laser, the sniper tracer and piercing shots. */
  private addBeam(from: THREE.Vector3, to: THREE.Vector3, color: number, life = 0.3): void {
    const geo = new THREE.BufferGeometry().setFromPoints([from, to]);
    const mat = new THREE.LineBasicMaterial({
      color,
      transparent: true,
      opacity: 0.95,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const beam = new THREE.Line(geo, mat);
    this.addEffect({
      obj: beam,
      ttl: life,
      life,
      onUpdate: (k) => {
        mat.opacity = 0.95 * (1 - k);
      },
      cleanup: () => {
        geo.dispose();
        mat.dispose();
      },
    });
  }

  private addLightning(from: THREE.Vector3, to: THREE.Vector3, color: number): void {
    const points: THREE.Vector3[] = [];
    const steps = 9;
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const p = from.clone().lerp(to, t);
      if (i > 0 && i < steps) {
        p.x += (this.rng() - 0.5) * 0.55;
        p.y += (this.rng() - 0.5) * 0.55;
        p.z += (this.rng() - 0.5) * 0.55;
      }
      points.push(p);
    }
    const geo = new THREE.BufferGeometry().setFromPoints(points);
    const mat = new THREE.LineBasicMaterial({
      color,
      transparent: true,
      opacity: 1,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const line = new THREE.Line(geo, mat);
    this.addEffect({
      obj: line,
      ttl: 0.22,
      life: 0.22,
      onUpdate: (k) => {
        mat.opacity = 1 - k;
      },
      cleanup: () => {
        geo.dispose();
        mat.dispose();
      },
    });
  }

  private addCone(origin: THREE.Vector3, dir: THREE.Vector3, length: number, color: number): void {
    const geo = new THREE.ConeGeometry(0.5, 1, 10, 1, true);
    geo.translate(0, -0.5, 0);
    const mat = new THREE.MeshBasicMaterial({
      color,
      transparent: true,
      opacity: 0.34,
      depthWrite: false,
      side: THREE.DoubleSide,
      blending: THREE.AdditiveBlending,
    });
    const mesh = new THREE.Mesh(geo, mat);
    const q = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, -1, 0), dir.clone().normalize());
    mesh.quaternion.copy(q);
    mesh.position.set(origin.x, 1.3, origin.z);
    mesh.scale.set(1.7, length, 1.7);
    this.addEffect({
      obj: mesh,
      ttl: 0.34,
      life: 0.34,
      onUpdate: (k) => {
        mat.opacity = 0.34 * (1 - k);
        mesh.scale.set(1.7 + k * 1.1, length, 1.7 + k * 1.1);
      },
      cleanup: () => {
        geo.dispose();
        mat.dispose();
      },
    });
  }

  private updateEffects(dt: number): void {
    const done: Effect[] = [];
    for (const effect of this.effects) {
      effect.life -= dt;
      const k = clamp(1 - effect.life / effect.ttl, 0, 1);
      effect.onUpdate(k);
      if (effect.life <= 0) done.push(effect);
    }
    if (done.length) {
      for (const effect of done) {
        this.fxLayer.remove(effect.obj);
        effect.cleanup?.();
      }
      this.effects = this.effects.filter((e) => !done.includes(e));
    }
  }

  // -------------------------------------------------------------------------
  // controls / UI glue
  // -------------------------------------------------------------------------

  private setSpeed(speed: number): void {
    this.speed = speed;
    this.paused = false;
    this.ui.setPaused(false);
    this.ui.setSpeed(speed);
  }

  private togglePause(): void {
    this.paused = !this.paused;
    this.ui.setPaused(this.paused);
  }

  /** The play control: resumes a paused game, otherwise launches the next wave. */
  private play(): void {
    if (this.paused) {
      this.togglePause();
      return;
    }
    this.startWave();
  }

  // -------------------------------------------------------------------------
  // loop
  // -------------------------------------------------------------------------

  private updateVisuals(raw: number): void {
    this.visualTime += raw;
    this.world.animate(raw, this.visualTime);

    if (this.boss && !this.boss.dead) {
      const ratio = clamp(this.boss.hp / this.boss.maxHp, 0, 1);
      const key = `${this.boss.def.name}:${Math.ceil(ratio * 200)}`;
      if (key !== this.lastBossKey) {
        this.lastBossKey = key;
        this.ui.setBoss(this.boss.def.name, ratio);
      }
    }

    if (this.selected) {
      this.selRing.rotation.z += raw * 0.8;
    }
    if (this.placing) {
      const pulse = 0.26 + Math.abs(Math.sin(this.visualTime * 3)) * 0.2;
      (this.hl1.material as THREE.MeshBasicMaterial).opacity = pulse;
      (this.hl2.material as THREE.MeshBasicMaterial).opacity = pulse;
    }
  }

  private animate = (): void => {
    requestAnimationFrame(this.animate);
    const raw = Math.min(0.05, this.clock.getDelta());
    if (!this.paused && !this.menuOpen && (this.phase === 'prep' || this.phase === 'fight')) {
      let remaining = raw * this.speed;
      let guard = 0;
      while (remaining > 0.0001 && guard++ < 16) {
        const step = Math.min(remaining, 0.033);
        this.update(step);
        remaining -= step;
      }
    }
    this.updateVisuals(raw);
    this.controls.update();
    this.renderer.render(this.scene, this.camera);
  };
}
